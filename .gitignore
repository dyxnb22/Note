.DS_Store

# Python caches and local environments
.pytest_cache/
__pycache__/
*.py[cod]
.venv/
venv/

# Local secrets
.env
.env.*
!.env.example

# Agent and application runtime state
.memory/
.tasks/
.mailboxes/
.transcripts/

# Common build artifacts
node_modules/
dist/
build/
target/

# Claudian 原始配置含环境变量、本机路径和会话；可复用偏好另存 config-templates/
.claudian/
Users/

# Obsidian 插件代码可从市场重装，不跟踪；插件设置(data.json)与 manifest 保留
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css

# Obsidian 窗口状态（包括独立的手机配置目录）
.obsidian*/workspace.json
.obsidian*/workspace-mobile.json

# 可重新生成的练习执行报告
/Learning/AI/实践/llm_learning/03_tool_calling_workflow/project/workflow_report.md
